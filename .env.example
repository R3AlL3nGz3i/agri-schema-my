# Used by the professor-review pipeline (Anthropic).
ANTHROPIC_API_KEY=sk-ant-...

# Which backend powers the grounded chatbot + photo diagnosis.
#   openai  -> gpt-4o-mini      (needs OPENAI_API_KEY, paid)
#   gemini  -> gemini-2.0-flash (needs GEMINI_API_KEY, free tier, no card)
# Defaults to openai when unset.
LLM_PROVIDER=openai

# Used by the grounded answer layer (/ask) and photo diagnosis (/diagnose).
# The vector search itself works without any key — these only power the
# AI-written answer and the photo symptom read.
OPENAI_API_KEY=sk-...

# Free Gemini key from Google AI Studio (https://aistudio.google.com/apikey).
# Only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=AIza...
